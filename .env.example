# Variables de entorno para Node.js Lab
# Copiar este archivo a .env y ajustar los valores según tu entorno

# Puerto del servidor API
PORT=3001

# Configuración de MySQL 8.4 (local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=nodejs_lab
DB_CONNECTION_LIMIT=10

# Frontend
VITE_API_URL=http://localhost:3001
