{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "lib": ["esnext"],
    "baseUrl": ".",
    "paths": {
      "@shared": ["../../packages/shared/src/index"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@content": ["../../packages/content/src/index"],
      "@content/*": ["../../packages/content/src/*"],
      "@runner": ["../../packages/runner/src/index"],
      "@runner/*": ["../../packages/runner/src/*"],
      "@db": ["../../packages/db/src/index"],
      "@db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", "vitest.config.ts"]
}
